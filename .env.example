# ====================================================================
# IPODecoded (JournalDecoded.in) Environment Variables
# ====================================================================

# Database:
# For Supabase:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Leave empty or set to sqlite:///ipodecoded.db for zero-setup local development
DATABASE_URL=

# Supabase API (Optional - for frontend direct connection)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server configuration
API_HOST=0.0.0.0
API_PORT=8000

# Scheduler intervals
IPO_FETCH_INTERVAL_HOURS=2
GMP_FETCH_INTERVAL_MINUTES=45
